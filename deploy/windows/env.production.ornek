# ÖRNEK: yalnız değişken ADLARI. DEĞER YAZMAYIN/COMMIT'LEMEYİN. Gerçek dosyalar C:\klinik\gizli\ altında, ayrı Windows hesaplarına izinli
# (docs/sunucu-kurulum.md §3, §10a). Her bölüm ayrı bir dosyadır; aynı dosyada birleştirmeyin (hesap ayrımı bozulur).
# Biçim: ANAHTAR=değer (satır başı # yorum). Node `--env-file` ile okunur: değerde boşluk/# varsa çift tırnak kullanın.
# Not: eski Vercel/Supabase dönemi adlar (CRON_SECRET, SUPABASE_*, AUTH_SECRET, STORAGE_DIR) KULLANILMAZ; karşılıkları aşağıdaki adlardır
#      (AUTH_SECRET → BETTER_AUTH_SECRET, STORAGE_DIR → DOSYA_KOKU, CRON_SECRET kalktı: işler Task Scheduler betikleri).

# ===================== uygulama.env  (okuyan: NT SERVICE\klinik-uygulama, sanal servis hesabı) =====================
# Uygulama veritabanı bağlantısı (rol: klinik_uygulama; yalnız localhost). Biçim: postgres://kullanici:PAROLA@localhost:5432/klinik
DATABASE_URL=
# Kimlik (Better Auth) bağlantısı (rol: kimlik_rolu)
KIMLIK_DATABASE_URL=
# Oturum imzalama gizlisi (uzun rastgele; rotasyonu tüm oturumları düşürür)
BETTER_AUTH_SECRET=
# Dışarıdan görünen adres, örn. https://klinik.firma.com.tr
BETTER_AUTH_URL=
# Dosya deposu kökü (web kökü DIŞINDA), örn. C:\klinik\dosya
DOSYA_KOKU=
# Sistem Chrome/Edge yürütülebilir dosyası (PDF), örn. C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_PATH=
# Dış servis gizlilerini (Paraşüt vb.) şifreleyen 32 bayt base64 anahtar. YEDEKTEN AYRI saklanır (docs/sunucu-kurulum.md §7)
GIZLI_VERI_ANAHTARI=
# Mesajlaşma merkezi (SMS/WhatsApp/e-posta); boşsa gönderim kuyruğa yazılır, gitmez
MESAJ_MERKEZ_BASE_URL=
MESAJ_MERKEZ_API_KEY=
# İsteğe bağlı: destek chatbot (varsayılan kapalı), oturum süresi sn (varsayılan 43200), havuz boyutları
# Güncelleme jetonu durum dosyası (guncelle.ps1 yazar, /api/saglik okur): C:\klinik\durum\jeton.json
GUNCELLEME_DURUM_DOSYASI=
DESTEK_CHATBOT_ACIK=
OTURUM_SURESI_SN=
DB_HAVUZ_MAKS=
DB_KIMLIK_HAVUZ_MAKS=

# ===================== bakim.env  (okuyan: svc-klinik-bakim; Task Scheduler betikleri) =====================
# bakim_rolu bağlantısı. DATABASE_URL ve BETTER_AUTH_SECRET burada BULUNMAZ.
BAKIM_DATABASE_URL=
MESAJ_MERKEZ_BASE_URL=
MESAJ_MERKEZ_API_KEY=

# ===================== yedek.env  (okuyan: svc-klinik-yedek; yedek.ps1) =====================
# klinik_yedek rolü bağlantısı (YALNIZ localhost)
YEDEK_DATABASE_URL=
# Şifreli yedeklerin yazıldığı klasör, örn. D:\yedek
YEDEK_HEDEF_KLASOR=
# age ORTAK anahtarı (age1...). Özel anahtar sunucuya girmez.
YEDEK_ALICI_ANAHTARI=
YEDEK_GUNLUK_SAKLAMA_GUN=30
YEDEK_AYLIK_SAKLAMA_AY=12
# AYRI diskteki/paylaşımdaki kopya klasörü (örn. E:\yedek-kopya). Yurt dışı hedef hukuk onayına bağlı.
YEDEK_DIS_KOPYA_HEDEFI=
# Dosya arşivi için (uygulama.env'deki DOSYA_KOKU ile aynı klasör)
DOSYA_KOKU=

# ===================== deploy.env  (okuyan: YALNIZ yöneticiler/SYSTEM; guncelle.ps1 + migrasyon-uygula.ps1) =====================
# GitHub sürüm paketlerini indirmek için: fine-grained personal access token, yalnız bu depo, izin "Contents: Read-only", süre sonlu.
GITHUB_REPO=
GITHUB_DEPLOY_TOKEN=
# İsteğe bağlı: jeton son kullanma tarihi notu (YYYY-MM-DD); GitHub yanıt başlığı gelmezse kullanılır. Yenileme: docs/sunucu-kurulum.md §10e
GITHUB_TOKEN_SON_KULLANMA=
# Migration uygulayıcı (rol: klinik_migrasyon; yalnız localhost). SÜPER KULLANICI parolası BURADA/pgpass'ta BULUNMAZ.
MIGRASYON_DATABASE_URL=
