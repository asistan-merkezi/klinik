# Global seçenekler (dosyanın İLK bloğu olmalı).
{
	# Yönetim API'si (varsayılan localhost:2019) KAPALI: yapılandırma yalnız bu dosyadan, servis yeniden başlatılarak değişir (`caddy reload` çalışmaz).
	admin off
}

# İSTEMCİ IP'Sİ: uygulama (hız sınırı, /api/saglik) YALNIZ X-Real-IP'ye güvenir. Caddy bunu HER istekte gerçek bağlantı adresiyle EZER (istemcinin gönderdiği
# değer atılır); X-Forwarded-For de aynı değerle ezilir, diğer "gerçek IP" başlıkları silinir. Uygulama 127.0.0.1:3000'de dinler, Caddy'yi atlayan dış erişim yoktur.
(istemci_ip) {
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up -Forwarded
	header_up -X-Client-IP
	header_up -True-Client-IP
	header_up -CF-Connecting-IP
}

# Caddy yapılandırması (Windows VM). Alan adı servis-kur.ps1 -AlanAdi ile değiştirilir; gizli değer içermez.
# Cloudflare proxy KAPALI (yalnız DNS): TLS doğrudan burada sonlanır (docs/sunucu-kurulum.md 3c — KVKK).
# Sertifika: Caddy otomatik (Let's Encrypt). 80 ve 443 dışarıya açık olmalı (HTTP-01/TLS-ALPN-01 için).
klinik.ornek.com.tr {
	# --- Cloudflare IP aralıkları (NOTU, ŞU AN PASİF) ---
	# Proxy KAPALI olduğu için "yalnız Cloudflare IP'lerinden gelen trafik" kısıtı UYGULANMAZ; açılırsa herkes bloklanırdı.
	# Proxy bilinçli olarak açılırsa (KVKK onayı sonrası): https://www.cloudflare.com/ips-v4 ve /ips-v6 listesi güncel çekilip
	#   @cloudflare_disi not remote_ip <aralıklar>
	#   respond @cloudflare_disi 403
	# ve `servers { trusted_proxies static <aralıklar> }` + header_up X-Real-IP {client_ip} ile gerçek IP alınır. Windows güvenlik
	# duvarında da 443 yalnız bu aralıklara açılmalıdır. SSE yolu (/api/canli) için Cloudflare 100 sn sınırı ayrıca ele alınmalı.

	# İstek gövdesi üst sınırları (aşan istek uygulamaya hiç ulaşmaz; 413). Belge/foto yükleme ucu uygulamanın dosya sınırından (50 MB, types/hasta-belge.ts
	# MAX_DOSYA_BOYUTU_BYTE) pay bırakacak kadar geniştir; diğer her yol (form/JSON/server action) 25 MB'ı geçemez. (İki request_body çakışırsa küçük olan
	# kazanır; bu yüzden genel sınır yükleme yolunu DIŞLAR.)
	@yukleme path /api/hasta-belge/foto-yukle
	@yukleme_disi not path /api/hasta-belge/foto-yukle
	request_body @yukleme {
		max_size 60MB
	}
	request_body @yukleme_disi {
		max_size 25MB
	}

	header {
		# HSTS KADEMELİ artırılır (docs/sunucu-kurulum.md §3d): şimdilik 1 hafta, includeSubDomains YOK, preload YOK. Geri alması mümkün olmayan uzun süreyi
		# ilk sertifika yenilemesi sorunsuz geçmeden vermeyin: bozuk sertifika + uzun HSTS = kullanıcılar siteye hiç giremez.
		Strict-Transport-Security "max-age=604800"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kamera: hasta foto yükleme için aynı kaynak; mikrofon/konum/ödeme kapalı.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	# NOT: Content-Security-Policy BİLİNÇLİ yok — Next.js satır içi betikleri nonce'suz çalışıyor; CSP için nonce altyapısı gerekir
	# (ayrı iş). Eklenirse önce Content-Security-Policy-Report-Only ile denenmeli.

	log {
		output file C:/klinik/log/caddy-erisim.log {
			roll_size 50MiB
			roll_keep 14
			roll_keep_for 336h
		}
		# Erişim günlüğü HİJYENİ: tek kullanımlık bağlantı belirteci (/b/<token>), şifre sıfırlama belirteci (?token=, /reset-password/<token>) ve
		# çerez/yetki başlıkları dosyaya YAZILMAZ (Caddy `filter` kodlayıcısı; uygulama günlükleri ayrıca lib/guvenlik/log-temizle.ts ile temizlenir).
		format filter {
			wrap json
			fields {
				request>uri regexp "((?:/b/|/reset-password/|[?&](?:token|jeton)=))[^/?&\s]+" "$1[GIZLI]"
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	# Canlı olay akışı (SSE, /api/canli): ARABELLEK KAPALI olmalı. flush_interval -1 olmazsa Caddy olayları biriktirir,
	# canlı çizelge/tablet güncellemeleri gecikir ya da hiç gelmez. Sıkıştırma akışı arabelleğe alabilir; bu yüzden `encode` yalnız
	# SSE dışındaki yolda (alttaki genel handle) açıktır.
	@canli path /api/canli
	handle @canli {
		reverse_proxy localhost:3000 {
			flush_interval -1
			import istemci_ip
			transport http {
				# Yanıt başlığı hemen döner; gövde (akış) süre sınırı OLMAMALI. Sunucu bağlantıyı en fazla 10 dk sonra kendisi kapatır
				# (lib/realtime/sse.ts SSE_OMUR_MS) ve istemci yeniden bağlanır; ping 25 sn'de bir gider.
				response_header_timeout 90s
				dial_timeout 5s
				keepalive 30s
			}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy localhost:3000 {
			import istemci_ip
			# Yavaş sorgular (Raporlar, PDF üretimi) için en az 90 sn; 120 sn seçildi.
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
			}
			# Uygulama yeniden başlarken (guncelle.ps1) kısa kesintide istekleri 10 sn'ye kadar bekletip yeniden dene.
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}
}
